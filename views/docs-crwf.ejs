      <div class="resource" id="crwf-update-item">
        <a href="#crwf-update-item" class="res-title">Update cart item</a>
        <div>
          <pre><code class="language-js">
            fetch('https://dummyjson.com/cart/firebase/update/&lt;YOUR-REGISTERED-ID&gt;', {
              method: 'POST',
