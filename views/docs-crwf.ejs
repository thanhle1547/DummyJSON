      <div class="resource" id="crwf-remove-item">
        <a href="#crwf-remove-item" class="res-title">Remove cart item</a>
        <div>
          <pre><code class="language-js">
            fetch('https://dummyjson.com/cart/firebase/remove/&lt;YOUR-REGISTERED-ID&gt;', {
              method: 'POST',
