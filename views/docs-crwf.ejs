<!DOCTYPE html>
<html lang="en">
<!-- header -->
<%- include('./partials/docs-head') %>

<body>
  <!-- header -->
  <%- include('./partials/header') %>

  <!-- side-nav -->
  <%- include('./partials/docs-side-nav') %>

  <section>
    <div class="content">
      <h1 class="docs-title">
        <img src="https://assets.dummyjson.com/public/img/icons/cart.svg" class="icon" alt="svg icon" /> Carts with Firebase - Docs
      </h1>
      <p class="display-para">
        The <strong>cart</strong> endpoint useful for prototyping e-commerce functionalities such as cart management and checkout processes.
      </p>

      <div class="resource" id="crwf-items">
        <a href="#crwf-items" class="res-title">Get cart items</a>
        <pre><code class="language-js">
          fetch('https://dummyjson.com/cart/firebase/items/&lt;YOUR-REGISTERED-ID&gt;', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer /* YOUR_TOKEN_HERE */', 
            },
          })
          .then(res => res.json())
          .then(console.log);
        </code></pre>

        <button class="show-output btn">Show Output</button>

        <pre class="output"><code class="language-json">
          {
            "products": [
              {
                "id": 1,
                "variantId": null,
                "title": "Essence Mascara Lash Princess",
                "price": 9.99,
                "stock": 5,
                "quantity": 1,
                "total": 9.99,
                "discountPercentage": 7.17,
                "discountedPrice": 9.27,
                "thumbnail": "https://cdn.dummyjson.com/products/images/beauty/Essence%20Mascara%20Lash%20Princess/thumbnail.png"
              }
            ],
            "total": 9.99,
            "discountedTotal": 9.27,
            "delivery": {
              "charge": 0
            },
            "totalQuantity": 1,
            "selectedCount": 0
          }
        </code></pre>
      </div>

      <div class="resource" id="crwf-add-item">
        <a href="#crwf-add-item" class="res-title">Add item to cart</a>
        <div>
          <pre><code class="language-js">
            fetch('https://dummyjson.com/cart/firebase/add/&lt;YOUR-REGISTERED-ID&gt;', {
              method: 'POST',
              headers: {
                'Authorization': 'Bearer /* YOUR_TOKEN_HERE */', 
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                productId: 1601034753736,
                productVariantId: 105029224428, // if exist
                quantity: 1
              })
            })
            .then(res => res.json())
            .then(console.log);
          </code></pre>
  
          <button class="show-output btn">Show Output</button>
  
          <pre class="output"><code class="language-json">
            {
              "products": [
                {
                  "id": 1,
                  "variantId": null,
